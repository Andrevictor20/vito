# Vito — template de variáveis de ambiente (sem segredos; copie para .env e preencha)
PORT=8180
APP_ENV=development
DB_PATH=./data/vito.db
JWT_SECRET=
DATA_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://vito.rasppi.cloud/api/v1/auth/google/callback
PUBLIC_BASE_URL=https://vito.rasppi.cloud
CORS_ALLOWED_ORIGINS=
SHORTIO_API_KEY=
SHORTIO_DOMAIN=vito.s.gy
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TUNNEL_TOKEN=

# Motores de Busca e Radares Inteligentes (Arquitetura de Vigília)
# URL do metabuscador SearXNG local (padrão Docker: http://searxng:8080; se rodar backend direto no host: http://localhost:8185)
SEARXNG_URL=http://searxng:8080
# Token gratuito da Brapi para cotações B3/Ações/FIIs (opcional; possui fallback determinístico para Yahoo Finance e AwesomeAPI)
BRAPI_TOKEN=
# Chave da Serper API para fallback externo de buscas na web (opcional)
SERPER_API_KEY=

