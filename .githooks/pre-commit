#!/usr/bin/env bash
# ==============================================================================
# .githooks/pre-commit: Gatekeeper de Segurança e Qualidade Local
# Previne commit acidental de credenciais, arquivos gigantes e conflitos não resolvidos.
# ==============================================================================
set -euo pipefail

echo "🔍 [Git Pre-Commit Hook] Validando integridade e segurança..."

# 1. Previne commit de marcadores de conflito de merge (<<<<<<<, =======, >>>>>>>)
if git diff --cached | grep -E '^[+](<{7}[[:space:]]|={7}[[:space:]]*$|>{7}[[:space:]])' > /dev/null 2>&1; then
  echo "❌ ERRO: Marcadores de conflito git detectados nas alterações preparadas!"
  exit 1
fi

# 2. Previne commit acidental de arquivos de segredos / chaves
SECRET_PATTERNS="(\.env$|\.env\.local$|\.pem$|\.key$|id_rsa|id_ed25519)"
STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
  if echo "$file" | grep -E "$SECRET_PATTERNS" > /dev/null 2>&1; then
    echo "❌ ERRO DE SEGURANÇA: Tentativa de commitar arquivo sensível: $file"
    echo "   Remova o arquivo do stage com: git reset HEAD $file"
    exit 1
  fi
done

# 3. Previne commit de arquivos muito grandes (> 10MB)
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    FILESIZE=$(wc -c <"$file")
    if [ "$FILESIZE" -gt 10485760 ]; then
      echo "❌ ERRO: Arquivo excede 10MB ($file). Considere Git LFS ou ignore."
      exit 1
    fi
  fi
done

# 4. Executa verificação de linters/formatters se disponíveis
if command -v ruff >/dev/null 2>&1; then
  echo "🐍 Executando ruff check..."
  ruff check . || exit 1
fi

if [ -f "package.json" ] && command -v npm >/dev/null 2>&1; then
  if npm run | grep -q "lint"; then
    echo "📦 Executando npm run lint..."
    npm run lint || exit 1
  fi
fi

echo "✅ [Git Pre-Commit Hook] Verificação concluída com sucesso."
exit 0
